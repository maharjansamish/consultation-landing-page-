# Required to accept and deliver consultation requests through Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEADS_FROM_EMAIL=Samish Digital Wave <consultations@your-verified-domain.com>
LEADS_TO_EMAIL=you@example.com

# Required to sign short-lived receipts for accepted submissions (32+ random characters).
SUBMISSION_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional display-only contact and media configuration.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_VIMEO_URL=
NEXT_PUBLIC_SCHEDULING_URL=
